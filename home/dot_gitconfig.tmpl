[alias]
    lg = log --branches --remotes --tags --graph --oneline --decorate

[init]
    defaultBranch = main

[rebase]
    updateRefs = true

# ============================================
# Diff tools
# ============================================

[merge]
    conflictStyle = zdiff3

[core]
    pager = sh -c 'command -v hunk >/dev/null 2>&1 && exec hunk pager || exec less'

[interactive]
    diffFilter = sh -c 'command -v delta >/dev/null 2>&1 && exec delta --color-only || exec cat'

[diff]
    tool = hunk

[difftool "hunk"]
    cmd = sh -c 'command -v hunk-difftool >/dev/null 2>&1 && exec hunk-difftool "$LOCAL" "$REMOTE" || exec diff -u "$LOCAL" "$REMOTE"'

[difftool]
    prompt = false
