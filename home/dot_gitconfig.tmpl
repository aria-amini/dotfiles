[alias]
    lg = log --branches --remotes --tags --graph --oneline --decorate

[init]
    defaultBranch = main

[rebase]
    updateRefs = true

[merge]
    conflictStyle = zdiff3

# ============================================
# Diff tools
# ============================================

[core]
    pager = hunk pager

[interactive]
    diffFilter = delta --color-only

[diff]
    tool = hunk

[difftool "hunk"]
    cmd = hunk-difftool "$LOCAL" "$REMOTE"

[difftool]
    prompt = false

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential

{{ if .work -}}
[credential "https://dev.azure.com"]
{{- if .isWSL }}
	helper = !'/mnt/c/Program Files/Git/mingw64/bin/git-credential-manager.exe'
{{- else }}
	helper = manager
{{- end }}
	useHttpPath = true

[credential "https://*.visualstudio.com"]
{{- if .isWSL }}
	helper = !'/mnt/c/Program Files/Git/mingw64/bin/git-credential-manager.exe'
{{- else }}
	helper = manager
{{- end }}
{{- end }}

