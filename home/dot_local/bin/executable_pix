#!/usr/bin/env sh
# pix — screenshot pair browser: television picker + imgap viewer.

set -u

IMG_RE='-actual\.(png|jpe?g|webp|gif|bmp|tiff?|avif)$'
IMG_EXT='\.(png|jpe?g|webp|gif|bmp|tiff?|avif)$'

die() {
  printf 'pix: %s\n' "$*" >&2
  exit 1
}

usage() {
  cat >&2 <<'EOF'
usage:
  pix                        scan cwd for Playwright/Vitest *-actual/-expected pairs
  pix <dir>                  scan dir for pairs
  pix <name>                 jump to pairs whose name matches
  pix <expected> <actual>    diff a single pair
  pix jj <rev> [file]        diff image changes in a jj revision
EOF
  exit 2
}

# One line per pair: name<TAB>expected<TAB>actual
scan_pairs() {
  root=$1
  fd --hidden --type f --exclude node_modules --exclude .jj --exclude .git \
    -- "$IMG_RE" "$root" | while IFS= read -r actual; do
    expected=$(printf '%s\n' "$actual" | sed 's/-actual\./-expected./')
    [ -f "$expected" ] || continue
    name=$(printf '%s\n' "$actual" | sed "s|^$root/||; s/-actual\.[a-z]*\$//")
    printf '%s\t%s\t%s\n' "$name" "$expected" "$actual"
  done
}

pick_pair() {
  tv --source-command "cat '$1'" \
    --source-display '{0}' \
    --source-output '{}' \
    --source-entry-delimiter "$(printf '\t')" \
    --preview-command "magick identify -format '%m %wx%h %b' {2} 2>/dev/null" \
    --preview-header '{0}'
}

open_pair() {
  expected=$(printf '%s\n' "$1" | cut -f2)
  actual=$(printf '%s\n' "$1" | cut -f3)
  imgap -i "$expected" "$actual"
}

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

[ $# -eq 0 ] && set -- .

case $1 in
  -h | --help)
    usage
    ;;
  jj)
    if [ $# -gt 3 ] || [ $# -lt 2 ]; then
      usage
    fi
    rev=$2
    diff=$(jj diff -r "$rev" --name-only 2>/dev/null) || die "jj diff failed for $rev"
    [ -n "$diff" ] || die "no changes in $rev"
    printf '%s\n' "$diff" | while IFS= read -r file; do
      printf '%s' "$file" | grep -Eq "$IMG_EXT" || continue
      if [ $# -eq 3 ] && [ "$3" != "$file" ]; then
        continue
      fi
      stem=$(printf '%s' "$file" | sed 's/[^a-zA-Z0-9._-]/__/g')
      ext=$(printf '%s' "$file" | sed 's/.*\.//')
      raw_before="$tmpdir/$stem.before.$ext"
      raw_after="$tmpdir/$stem.after.$ext"
      # Wrap the path in literal quotes: jj parses the argument as a
      # fileset, where $ would otherwise start a function call.
      jj file show -r "$rev-" -- "\"$file\"" > "$raw_before" 2>/dev/null
      jj file show -r "$rev" -- "\"$file\"" > "$raw_after" 2>/dev/null
      if [ ! -s "$raw_before" ] && [ ! -s "$raw_after" ]; then
        continue
      fi
      before="$tmpdir/$stem.before.png"
      after="$tmpdir/$stem.after.png"
      if [ -s "$raw_before" ]; then
        magick "${raw_before}[0]" "$before"
      else
        magick "${raw_after}[0]" -alpha off -fill white -colorize 100 "$before"
      fi
      if [ -s "$raw_after" ]; then
        magick "${raw_after}[0]" "$after"
      else
        magick "${raw_before}[0]" -alpha off -fill white -colorize 100 "$after"
      fi
      printf '%s\t%s\t%s\n' "$file" "$before" "$after"
    done > "$tmpdir/pairs.tsv"
    if [ ! -s "$tmpdir/pairs.tsv" ]; then
      die "no image changes in $rev"
    fi
    if [ "$(wc -l < "$tmpdir/pairs.tsv")" -eq 1 ]; then
      line=$(cat "$tmpdir/pairs.tsv")
    else
      line=$(pick_pair "$tmpdir/pairs.tsv")
      [ -n "$line" ] || exit 0
    fi
    open_pair "$line"
    ;;
  *)
    if [ $# -eq 2 ] && [ -f "$1" ] && [ -f "$2" ]; then
      imgap -i "$1" "$2"
      exit 0
    fi
    if [ -d "$1" ]; then
      scan_pairs "$(cd "$1" && pwd)" > "$tmpdir/pairs.tsv"
    else
      scan_pairs "$(pwd)" > "$tmpdir/pairs.tsv"
      grep -i -- "$1" "$tmpdir/pairs.tsv" > "$tmpdir/matches.tsv" || die "no pair matches '$1'"
      mv "$tmpdir/matches.tsv" "$tmpdir/pairs.tsv"
    fi
    if [ ! -s "$tmpdir/pairs.tsv" ]; then
      die "no screenshot pairs found"
    fi
    if [ "$(wc -l < "$tmpdir/pairs.tsv")" -eq 1 ]; then
      line=$(cat "$tmpdir/pairs.tsv")
    else
      line=$(pick_pair "$tmpdir/pairs.tsv")
      [ -n "$line" ] || exit 0
    fi
    open_pair "$line"
    ;;
esac
