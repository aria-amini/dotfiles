#!/usr/bin/env python3

import json
import os
from pathlib import Path
import sys


def main():
    home = Path(os.environ.get("T3CODE_HOME") or Path.home() / ".t3")
    state_file = home / "runtime/service-state.json"
    try:
        state = json.loads(state_file.read_text())
        version = state["activeVersion"]
        if not isinstance(version, str) or not version or Path(version).name != version:
            raise ValueError("Invalid activeVersion")
        binary = home / "runtime/versions" / version / "t3"
        os.execv(str(binary), [str(binary), *sys.argv[1:]])
    except (OSError, ValueError, KeyError) as error:
        print(f"t3: cannot launch the active fork runtime: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
