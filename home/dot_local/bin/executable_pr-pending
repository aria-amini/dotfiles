#!/usr/bin/python3
"""Stop hook for Claude Code and Codex: keep the agent going while its PR needs attention.

Reads the hook's JSON on stdin and checks the open PR for the current branch. If it has review
threads whose last comment is someone else's, failing checks, or local commits that are not
pushed, it prints {"decision": "block", "reason": ...}, which both harnesses treat as "continue
with this as the next prompt". It nudges once per turn (stop_hook_active) and never blocks on
its own errors: no repo, no PR, no network, or a timeout all let the agent stop.

Run by hand (no hook input), it prints the report as text, exits 1 when something is pending,
and exits 1 with an error when it cannot check, so a failed query never reads as "all clear".
"""

import json
import subprocess
import sys

TIMEOUT = 6  # per call; four calls must fit the hooks' 30-second budget
FAILED = {
    "FAILURE",
    "ERROR",
    "TIMED_OUT",
    "CANCELLED",
    "ACTION_REQUIRED",
    "STARTUP_FAILURE",
}

THREADS_QUERY = """
query($owner: String!, $repo: String!, $number: Int!, $endCursor: String) {
  viewer { login }
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $number) {
      reviewThreads(first: 100, after: $endCursor) {
        nodes { isResolved path comments(last: 1) { nodes { author { login } url } } }
        pageInfo { hasNextPage endCursor }
      }
    }
  }
}
"""


def run(args: list[str], cwd: str) -> str:
    return subprocess.run(
        args, cwd=cwd, capture_output=True, text=True, check=True, timeout=TIMEOUT
    ).stdout


def pending(
    threads: list[dict], viewer: str, checks: list[dict], ahead: int
) -> list[str]:
    """What still needs the agent: unanswered threads, failed checks, unpushed commits."""
    items = []
    for thread in threads:
        last = (thread.get("comments") or {}).get("nodes") or []
        author = ((last[0].get("author") or {}).get("login")) if last else None
        if not thread.get("isResolved") and author != viewer:
            items.append(
                f"unanswered review thread on {thread.get('path')}: {last[0]['url'] if last else ''}"
            )
    # A rerun or a superseded run (often CANCELLED) shares its name with the newest
    # run, so judge each check by its newest run only.
    latest: dict[str, dict] = {}
    for check in checks:
        name = check.get("name") or check.get("context") or ""
        started = check.get("startedAt") or check.get("createdAt") or ""
        kept = latest.get(name)
        if kept is None or started >= (kept.get("startedAt") or kept.get("createdAt") or ""):
            latest[name] = check
    for check in latest.values():
        if (check.get("conclusion") or check.get("state") or "").upper() in FAILED:
            items.append(f"failing check: {check.get('name') or check.get('context')}")
    if ahead:
        items.append(f"{ahead} local commit(s) not pushed")
    return items


def main() -> int:
    try:
        event = json.loads(sys.stdin.read() or "{}") if not sys.stdin.isatty() else {}
    except json.JSONDecodeError:
        event = {}
    if event.get("stop_hook_active"):
        return 0  # already nudged once this turn
    hook = bool(event.get("hook_event_name"))
    cwd = event.get("cwd") or "."
    try:
        branch = run(["git", "branch", "--show-current"], cwd).strip()
        if not branch:
            if not hook:
                print("pr-pending: not on a branch")
            return 0
        try:
            pr = json.loads(
                run(
                    [
                        "gh",
                        "pr",
                        "view",
                        "--json",
                        "number,state,url,statusCheckRollup",
                    ],
                    cwd,
                )
            )
        except subprocess.CalledProcessError as error:
            if "no pull requests found" not in (error.stderr or ""):
                raise
            if not hook:
                print(f"pr-pending: no PR for branch {branch}")
            return 0
        if pr.get("state") != "OPEN":
            if not hook:
                print(f"pr-pending: PR {pr.get('url')} is {pr.get('state', '').lower()}")
            return 0
        # The PR's own repository, from its URL: https://github.com/<owner>/<repo>/pull/<n>
        owner, repo = pr["url"].split("/")[3:5]
        # --paginate --slurp follows endCursor and returns every page as one list.
        pages = json.loads(
            run(
                [
                    "gh",
                    "api",
                    "graphql",
                    "--paginate",
                    "--slurp",
                    "-f",
                    f"query={THREADS_QUERY}",
                    "-f",
                    f"owner={owner}",
                    "-f",
                    f"repo={repo}",
                    "-F",
                    f"number={pr['number']}",
                ],
                cwd,
            )
        )
        data = pages[0]["data"]
        threads = [
            node
            for page in pages
            for node in page["data"]["repository"]["pullRequest"]["reviewThreads"]["nodes"]
        ]
        try:
            ahead = int(
                run(["git", "rev-list", "--count", "@{upstream}..HEAD"], cwd).strip()
            )
        except subprocess.CalledProcessError:
            ahead = 0  # no upstream branch
        items = pending(
            threads, data["viewer"]["login"], pr.get("statusCheckRollup") or [], ahead
        )
    except (
        subprocess.SubprocessError,
        OSError,
        KeyError,
        TypeError,
        json.JSONDecodeError,
    ) as error:
        if hook:
            return 0  # never trap the agent on our own failure
        detail = getattr(error, "stderr", None) or error
        print(f"pr-pending: could not check the PR: {detail}", file=sys.stderr)
        return 1
    if not hook:
        print(f"PR {pr['url']}: " + ("needs attention" if items else "nothing pending"))
        for item in items:
            print(f"- {item}")
        return 1 if items else 0
    if items:
        reason = f"PR {pr['url']} still needs attention before you stop:\n" + "\n".join(
            f"- {item}" for item in items
        )
        print(json.dumps({"decision": "block", "reason": reason}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
