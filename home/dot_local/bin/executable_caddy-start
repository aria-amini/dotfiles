#!/usr/bin/env bash
set -euo pipefail

cd "$HOME"
credentials="$HOME/.config/personal-secrets/caddy.env"
if [[ ! -s "$credentials" ]]; then
  printf 'Caddy startup failed: %s is missing or empty.\n' "$credentials" >&2
  exit 1
fi
unset CF_API_TOKEN
# shellcheck disable=SC1090
source "$credentials"
if [[ -z "${CF_API_TOKEN:-}" ]]; then
  printf 'Caddy startup failed: local CF_API_TOKEN is empty.\n' >&2
  exit 1
fi

export MISE_AUTO_INSTALL=false

# Tailscale can start after the user-level Pitchfork boot service.
for ((attempt = 0; attempt < 60; attempt++)); do
  address="$(tailscale ip -4 2>/dev/null || true)"
  if [[ -n "$address" ]] && ip -4 address show dev tailscale0 2>/dev/null | grep -Fq "inet $address/"; then
    export CADDY_BIND="$address"
    exec mise exec http:caddy-cf -- caddy-cf run --config "$HOME/.config/caddy-lab/Caddyfile"
  fi
  sleep 1
done

printf 'Caddy startup failed: Tailscale address is unavailable.\n' >&2
exit 1
