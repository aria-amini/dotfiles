#!/bin/sh
# impeccable-decision: publish an impeccable serve-question decision page on the tailnet.
#
# Serves the page through a Host-rewrite hop (the engine rejects proxied Host
# headers) on a dedicated tailscale serve port (443 belongs to caddy-cf), with
# an engine lifetime long enough for a human decision.
#
# Usage:
#   impeccable-decision serve <payload.json> [https-port]   # default 8449
#   impeccable-decision wait [key]                          # key defaults to last serve
#   impeccable-decision down
set -eu

ENGINE="${IMPECCABLE_ENGINE:-$HOME/.pi/agent/skills/impeccable/scripts/impeccable}"
HOP="$HOME/.local/lib/impeccable-hop.js"
HOP_PORT=45524
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/impeccable-decision"
STATE="$STATE_DIR/state"

hop_pids() { pgrep -f "^node $HOP" 2>/dev/null || true; }

dns_name() {
	tailscale status --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))'
}

case "${1:-}" in
serve)
	payload=$2
	https_port=${3:-8449}
	[ -f "$payload" ] || { echo "payload not found: $payload" >&2; exit 1; }
	mkdir -p "$STATE_DIR"

	out=$(IMPECCABLE_QUESTION_FORCE=1 "$ENGINE" serve-question \
		--start --payload "$payload" --timeout 3600 --idle-grace 3600 2>&1)
	key=$(printf '%s\n' "$out" | sed -n 's/^QUESTION KEY: //p')
	engine_port=$(printf '%s\n' "$out" | grep -o '127\.0\.0\.1:[0-9]*' | head -1 | cut -d: -f2)
	if [ -z "$key" ] || [ -z "$engine_port" ]; then
		printf '%s\n' "$out" >&2
		exit 1
	fi

	hop_pids | xargs -r kill 2>/dev/null || true
	sleep 0.3
	nohup node "$HOP" "$engine_port" >>"$STATE_DIR/hop.log" 2>&1 &
	sleep 0.5

	tailscale serve --https="$https_port" off >/dev/null 2>&1 || true
	tailscale serve --bg --https="$https_port" "$HOP_PORT" >/dev/null

	name=$(dns_name)
	url="https://$name:$https_port/"
	printf 'url=%s\nkey=%s\nengine_port=%s\nhttps_port=%s\n' \
		"$url" "$key" "$engine_port" "$https_port" >"$STATE"
	echo "DECISION URL: $url"
	echo "DECISION KEY: $key"
	;;
wait)
	key=${2:-$(sed -n 's/^key=//p' "$STATE" 2>/dev/null || true)}
	[ -n "$key" ] || { echo "no key given and no prior serve state" >&2; exit 1; }
	while :; do
		"$ENGINE" serve-question --wait --key "$key"
		rc=$?
		[ "$rc" -ne 3 ] && exit "$rc"
	done
	;;
down)
	https_port=$(sed -n 's/^https_port=//p' "$STATE" 2>/dev/null || true)
	[ -n "$https_port" ] && tailscale serve --https="$https_port" off >/dev/null 2>&1 || true
	hop_pids | xargs -r kill 2>/dev/null || true
	rm -f "$STATE"
	echo "decision page down"
	;;
*)
	echo "usage: $0 serve <payload.json> [https-port] | wait [key] | down" >&2
	exit 1
	;;
esac
