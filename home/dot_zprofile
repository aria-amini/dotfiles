# Source Nix profile first so nix-installed tools are available
if [ -e $HOME/.nix-profile/etc/profile.d/nix.sh ]; then . $HOME/.nix-profile/etc/profile.d/nix.sh; fi

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

export PNPM_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

# SSOT for this VM's tailnet address; dev servers bind it so host-side
# devices can reach them. Projects fall back to `tailscale ip -4`.
export TAILSCALE_IP="100.103.205.111"

# Personal secret vault (Infisical via varlock; schema in
# ~/.config/secrets/.env.schema). Keys resolve into login-shell env so every
# project and tool sees process env; INFISICAL_* plumbing stays internal.
# Failures stay silent so a broken vault never blocks a shell.
_varlock="$HOME/.local/share/mise/shims/varlock"
if [ -d "$HOME/.config/secrets" ] && [ -x "$_varlock" ]; then
  eval "$("$_varlock" load -p "$HOME/.config/secrets" --format shell --compact --filter '!INFISICAL_*' 2>/dev/null)"
fi
unset _varlock
