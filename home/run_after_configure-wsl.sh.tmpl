{{ if .isWSL -}}
#!/usr/bin/env bash
set -euo pipefail

windows_home=$(wslpath "$(cmd.exe /d /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r')")
temp_dir=$(mktemp -d)
trap 'rm -rf "$temp_dir"' EXIT

cat > "$temp_dir/wsl.conf" <<'EOF'
{{ template "wsl.conf" . -}}
EOF
cat > "$temp_dir/hosts" <<'EOF'
{{ template "wsl-hosts" . -}}
EOF
cat > "$temp_dir/wslconfig" <<'EOF'
{{ template "wslconfig" . -}}
EOF
cat > "$temp_dir/wsl-loopback-routes" <<'EOF'
{{ template "wsl-loopback-routes" . -}}
EOF
cat > "$temp_dir/wsl-loopback-routes.service" <<'EOF'
{{ template "wsl-loopback-routes.service" . -}}
EOF

system_changed=false
cmp -s "$temp_dir/wsl.conf" /etc/wsl.conf || system_changed=true
cmp -s "$temp_dir/hosts" /etc/hosts || system_changed=true

if [[ "$system_changed" == true ]]; then
  backup_dir="/var/backups/dotfiles-wsl/$(date -u +%Y%m%dT%H%M%SZ)"
  sudo install -d -m 700 "$backup_dir"
  [[ ! -f /etc/wsl.conf ]] || sudo cp -a /etc/wsl.conf "$backup_dir/"
  [[ ! -f /etc/hosts ]] || sudo cp -a /etc/hosts "$backup_dir/"
  sudo install -m 644 "$temp_dir/wsl.conf" /etc/wsl.conf
  sudo install -m 644 "$temp_dir/hosts" /etc/hosts
fi

if ! cmp -s "$temp_dir/wslconfig" "$windows_home/.wslconfig"; then
  [[ ! -f "$windows_home/.wslconfig" ]] || cp -a "$windows_home/.wslconfig" "$windows_home/.wslconfig.bak"
  install -m 644 "$temp_dir/wslconfig" "$windows_home/.wslconfig"
fi

ssh_dir="$windows_home/.ssh"
ssh_config="$ssh_dir/config"
marker_start='# aamini-dotfiles:start'
marker_end='# aamini-dotfiles:end'
managed="$marker_start
SendEnv TERM_PROGRAM"
# SetEnv as a config keyword needs OpenSSH 8.7+; older ssh aborts on it.
win_ssh='/mnt/c/Windows/System32/OpenSSH/ssh.exe'
if [[ -f "$win_ssh" ]]; then
  ssh_version=$("$win_ssh" -V 2>&1 | sed -n 's/.*OpenSSH_for_Windows_\([0-9.]*\).*/\1/p')
  if [[ -n "$ssh_version" ]] && awk -v v="$ssh_version" 'BEGIN{split(v,a,"."); exit !(a[1]>8 || (a[1]==8 && a[2]>=7))}'; then
    managed+=$'\nSetEnv TERM_PROGRAM=WezTerm'
  fi
fi
managed+=$'\n'"$marker_end"

current=""
[[ ! -f "$ssh_config" ]] || current=$(tr -d '\r' < "$ssh_config" | awk -v s="$marker_start" -v e="$marker_end" '
  index($0, s) == 1 { skip = 1; next }
  index($0, e) == 1 { skip = 0; next }
  !skip')
if [[ -z "$current" ]]; then
  desired="$managed"
else
  desired="$current
$managed"
fi
if ! cmp -s <(printf '%s\n' "$desired") "$ssh_config" 2>/dev/null; then
  mkdir -p "$ssh_dir"
  [[ ! -f "$ssh_config" ]] || cp -a "$ssh_config" "$ssh_config.bak"
  printf '%s\n' "$desired" > "$temp_dir/win-ssh-config"
  install -m 600 "$temp_dir/win-ssh-config" "$ssh_config"
fi

service_changed=false
cmp -s "$temp_dir/wsl-loopback-routes" /usr/local/sbin/wsl-loopback-routes || service_changed=true
cmp -s "$temp_dir/wsl-loopback-routes.service" /etc/systemd/system/wsl-loopback-routes.service || service_changed=true

if [[ "$service_changed" == true ]]; then
  sudo install -m 755 "$temp_dir/wsl-loopback-routes" /usr/local/sbin/wsl-loopback-routes
  sudo install -m 644 "$temp_dir/wsl-loopback-routes.service" /etc/systemd/system/wsl-loopback-routes.service
  sudo systemctl daemon-reload
fi
sudo systemctl enable --now wsl-loopback-routes.service
{{ end -}}
