#!/bin/sh
# Preserve external appends (nix installer, vite-plus, etc.); write our
# profile once. modify_ targets are never conflict-prompted, unlike
# dot_ targets which break apply when anything mutates the file.
contents=$(cat)
if [ -n "$contents" ]; then
  printf '%s\n' "$contents"
fi
case "$contents" in
  *"bash login shells (WSL default"*) ;;
  *)
    cat <<'BP_EOF'
# bash login shells (WSL default, servers). zsh uses .zprofile.
# Our setup runs first; the shared ~/.profile (Ubuntu defaults, the nix
# installer line, vite-plus) is chained in last. Everything here is
# idempotent so nested login shells don't grow PATH.

case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

case ":$PATH:" in
  *":$HOME/.local/share/mise/shims:"*) ;;
  *) export PATH="$HOME/.local/share/mise/shims:$PATH" ;;
esac

if [ -f "$HOME/.profile" ]; then
  . "$HOME/.profile"
fi
BP_EOF
  ;;
esac
