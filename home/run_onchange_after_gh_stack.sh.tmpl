#!/usr/bin/env bash
# Install the gh-stack extension (`gh stack`) at a pinned version. gh keeps extensions in its own
# folder, so mise cannot manage this one; changing the version below reruns this script.
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
version="v0.3.0"
# Setup applies dotfiles before it installs mise tools, so install gh here if it is missing;
# otherwise this script would exit early and never run again.
command -v gh > /dev/null 2>&1 || mise install --quiet github-cli
# Accept only the pinned release from github/gh-stack, not a fork or a dev build.
if ! gh extension list 2>/dev/null | grep -qE "^gh stack[[:space:]]+github/gh-stack[[:space:]]+${version}\b"; then
  # --force replaces an existing install in place, so a failed download keeps the old one.
  gh extension install github/gh-stack --pin "$version" --force
fi
