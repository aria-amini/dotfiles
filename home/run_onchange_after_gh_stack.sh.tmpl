{{ if and (ne (env "DOTFILES_PROFILE") "core") (ne (env "DOTFILES_SKIP_MANAGED_TOOLS") "true") -}}
#!/usr/bin/env bash
# Install the gh-stack extension (`gh stack`) at a pinned version. Skipped on the core profile,
# which installs no managed tools. gh keeps extensions in its own
# folder, so mise cannot manage this one; changing the version below reruns this script.
set -euo pipefail
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
version="v0.3.0"
# Setup applies dotfiles before it installs mise tools, so install gh here if it is missing;
# otherwise this script would exit early and never run again.
command -v gh > /dev/null 2>&1 || mise install --quiet github-cli
# Accept only github.com/github/gh-stack pinned at exactly this tag, read from gh's install manifest.
dir="${XDG_DATA_HOME:-$HOME/.local/share}/gh/extensions/gh-stack"
field() { sed -n "s/^$1: //p" "$dir/manifest.yml" 2>/dev/null; }
if [[ "$(field host)/$(field owner)/$(field tag)/$(field ispinned)" != "github.com/github/$version/true" ]]; then
  # --force only upgrades in place, so move any other build aside, install the pin,
  # and put the old build back if the install fails.
  backup="$(mktemp -d)"
  [[ -e "$dir" ]] && mv "$dir" "$backup/"
  if ! gh extension install https://github.com/github/gh-stack --pin "$version"; then
    rm -rf "$dir"
    [[ -e "$backup/gh-stack" ]] && mv "$backup/gh-stack" "$dir"
    rm -rf "$backup"
    exit 1
  fi
  rm -rf "$backup"
fi
{{ end -}}
