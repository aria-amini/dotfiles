{{- $isWSL := false -}}
{{- if and (eq .chezmoi.os "linux") (lookPath "wslpath") -}}{{- $isWSL = true -}}{{- end -}}
{{- $isLima := contains "lima" .chezmoi.hostname -}}
{{- $defaultSource := printf "%s/dotfiles" .chezmoi.homeDir -}}
{{- if eq .chezmoi.os "darwin" -}}{{- $defaultSource = printf "%s/Developer/dotfiles" .chezmoi.homeDir -}}{{- end -}}

sourceDir = {{ promptStringOnce . "sourceDir" "Dotfiles checkout" $defaultSource | quote }}

[data]
work = {{ promptBoolOnce . "work" "Work machine" false }}
isWSL = {{ $isWSL }}
isLima = {{ $isLima }}
