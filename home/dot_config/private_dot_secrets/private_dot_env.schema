# Personal secret vault — values resolve from self-hosted OpenBao
# (https://vault.ariaamini.com) at load time. Auth is the CLI token file at
# ~/.bao-token (created by `bao login`, or pasted manually); the token must
# carry the personal-keys-reader policy. Only this schema is committed by
# chezmoi; `.env.local` beside it stays unmanaged and normally empty.
# This file uses @env-spec. See https://varlock.dev/env-spec
# @defaultRequired=false @defaultSensitive=false
# @plugin(@varlock/hashicorp-vault-plugin@2.0.0)
# @initHcpVault(url="https://vault.ariaamini.com", pathPrefix="kv/personal-keyring")
# ---

# @required @sensitive
Z_AI_API_TOKEN=vaultSecret("ai")

# Stored in OpenBao as OPENAI_API_TOKEN; exported under the name the
# ecosystem expects.
# @required @sensitive
OPENAI_API_KEY=vaultSecret("ai#OPENAI_API_TOKEN")
