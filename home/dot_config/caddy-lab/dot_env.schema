# TLS edge secrets for the Caddy wildcard-cert daemon (global pitchfork
# daemon "tls"). Values resolve at load time; auth is the CLI token file at
# ~/.bao-token (policy personal-keys-reader). Only this schema is committed
# by chezmoi; `.env.local` beside it stays unmanaged.
# This file uses @env-spec. See https://varlock.dev/env-spec
# @defaultRequired=false @defaultSensitive=false
# @plugin(@varlock/hashicorp-vault-plugin@2.0.0)
# @initHcpVault(url="https://vault.ariaamini.com", pathPrefix="kv/personal-keyring")
# ---

# Cloudflare API token for the DNS-01 challenge backing
# *.dev.ariaamini.com. Stored in OpenBao under
# kv/personal-keyring/caddy-lab; the device-encrypted value in .env.local
# shadows this until that entry exists.
# @required @sensitive
CF_API_TOKEN=vaultSecret("caddy-lab#CF_API_TOKEN")
